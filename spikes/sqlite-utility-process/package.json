{
  "name": "spike-sqlite-utility-process",
  "private": true,
  "description": "PROTOTYPE, throw away: does better-sqlite3 + FTS5 work in an Electron utilityProcess, packaged in asar?",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --mac dir",
    "start:packaged": "./dist/mac-arm64/spike.app/Contents/MacOS/spike"
  },
  "build": {
    "appId": "dev.normie.spike",
    "productName": "spike",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "identity": null
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  },
  "version": "0.0.0",
  "author": "spike"
}
