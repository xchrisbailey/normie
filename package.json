{
  "name": "normie",
  "version": "0.1.0",
  "private": true,
  "description": "Keyboard-first desktop mail client",
  "author": "Chris Bailey",
  "main": "out/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && node scripts/check-bundles.mjs && npm run smoke",
    "prepare": "git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs",
    "start": "npm run build && electron .",
    "start:fake": "npm run build && NORMIE_PROVIDER=fake electron .",
    "smoke": "npm run build && NORMIE_PROVIDER=fake NORMIE_SMOKE=1 electron . && NORMIE_SMOKE=1 electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && electron-builder --mac",
    "package:dir": "npm run build && electron-builder --mac dir",
    "install-app": "node scripts/install-app.mjs",
    "real-copy": "node scripts/real-copy.mjs",
    "smoke:packaged": "NORMIE_PROVIDER=fake NORMIE_SMOKE=1 ./dist/mac-arm64/Normie.app/Contents/MacOS/Normie",
    "bench": "node bench/run.mjs",
    "test:live": "vitest run --config vitest.live.config.mts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "dompurify": "3.5.0",
    "imapflow": "2.12.2",
    "mailparser": "3.15.0",
    "marked": "18.3.0",
    "nodemailer": "10.6.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@cloudflare/oxlint-config": "0.2.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tanstack/react-virtual": "3.14.28",
    "@types/babel__core": "7.20.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "electron-winstaller": false,
    "fsevents": false,
    "esbuild": false
  },
  "build": {
    "appId": "dev.normie.app",
    "productName": "Normie",
    "asar": true,
    "files": [
      "out/**",
      "package.json",
      "!node_modules/better-sqlite3/prebuilds/{win32,linux,linuxmusl}-*.node",
      "!node_modules/better-sqlite3/{src,deps,docs,benchmark}/**"
    ],
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Normie"
    },
    "npmRebuild": false
  }
}
